# Human-readable service name and deployment environment.
APP_NAME=AI Customer Service
ENVIRONMENT=development
# Leave empty to expose the requested endpoints directly at the root path.
API_V1_PREFIX=
# SQLAlchemy connection URL; Docker Compose replaces the hostname for its database service.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_customer_service
# OpenAI-compatible provider endpoint, secret key, and model identifier.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Network timeout and maximum amount of prior conversation context sent to the model.
LLM_TIMEOUT_SECONDS=30
CONVERSATION_HISTORY_LIMIT=20